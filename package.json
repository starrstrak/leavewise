{
  "name": "leavewise-proto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototype de gestion des conges et remplacements (pharmacie, FR). Donnees fictives.",
  "scripts": {
    "dev": "tsx app/src/server.ts",
    "start": "tsx app/src/server.ts",
    "seed": "tsx demo/seed.ts",
    "demo": "tsx demo/demo.ts",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "site:build": "node site/build.mjs",
    "test:site": "node site/site-tests.mjs http://localhost:${PORT:-3000}/site/",
    "test:ui": "node app/test/ui-smoke.mjs http://localhost:${PORT:-3000}",
    "test:a11y": "node app/test/a11y.mjs http://localhost:${PORT:-3000}",
    "test:contrast": "node app/test/contrast-render.mjs http://localhost:${PORT:-3000}",
    "test:site:chromium": "BROWSER=chromium node site/site-tests.mjs http://localhost:${PORT:-3000}/site/",
    "test:site:firefox": "BROWSER=firefox node site/site-tests.mjs http://localhost:${PORT:-3000}/site/",
    "test:site:webkit": "BROWSER=webkit node site/site-tests.mjs http://localhost:${PORT:-3000}/site/"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/node": "^22.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
